# PRISM example environment file.
#
# Every value here is a placeholder. Copy to `.env` and edit locally.
# NEVER commit a real token, password or secret.
#
# The GitHub token is optional: public pull requests work without one.
# Create a read-only token only if you hit the anonymous rate limit.
PRISM_GITHUB_TOKEN=ghp_replace_me_with_a_read_only_token

# Input and resource limits (bytes unless stated otherwise).
PRISM_MAX_DIFF_BYTES=5242880
PRISM_MAX_PATCH_BYTES=2097152
PRISM_MAX_FILES=300
PRISM_MAX_RESPONSE_BYTES=8388608
PRISM_MAX_PAGES=100
PRISM_HTTP_TIMEOUT_SECONDS=20

# Finding policy.
PRISM_MIN_SEVERITY=informational
PRISM_EXCLUDED_RULES=

# Review behaviour.
PRISM_ENABLE_EXTERNAL_TOOLS=false
PRISM_ENABLE_LLM_EXTENSION=false
PRISM_INCLUDE_GENERATED_AT=false

# Optional coverage report (Cobertura XML) produced by your own test run.
PRISM_COVERAGE_REPORT=
