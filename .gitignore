# Secrets and local configuration — NEVER commit these.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*.token

# Generated review artefacts and evidence are reproducible; keep them out of the repo
# unless a specific demonstration artefact is intentionally committed under examples/.
evidence/
*.log
*.tmp

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local git sample projects created by the demo script
samples/**/.git/
