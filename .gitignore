*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
develop-eggs/
wheels/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
